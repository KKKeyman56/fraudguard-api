# ----- Network: 'base' (mainnet) atau 'base-sepolia' (testnet) -----
NETWORK=base-sepolia

# RPC Base. Pilihan:
#   - Publik       : https://mainnet.base.org  /  https://sepolia.base.org
#   - Alchemy      : https://base-mainnet.g.alchemy.com/v2/<API_KEY>
#   - Infura       : https://base-mainnet.infura.io/v3/<API_KEY>
BASE_RPC_URL=https://sepolia.base.org

# WALLET - JANGAN commit private key asli. Pakai wallet khusus bot.
PRIVATE_KEY=

# Diisi setelah deploy.py
LEVERAGE_CONTRACT=

# ----- Parameter risk -----
MIN_MARGIN_OF_SAFETY=0.15   # reject trade kalau buffer < 15%
SLIPPAGE_BPS=50             # 0.50% toleransi slippage swap
UNISWAP_POOL_FEE=500        # fee tier Uniswap V3: 500=0.05%, 3000=0.3%

# liquidation threshold Aave (fallback; idealnya dibaca on-chain)
LIQ_THRESHOLD_WETH=0.83
LIQ_THRESHOLD_USDC=0.86

# SQLite
DB_PATH=leverage_trades.db
